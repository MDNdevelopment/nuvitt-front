# URL pública del sitio (canonical, sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://nuvitt.com

# Destino del formulario de contacto (FormSubmit). Por defecto: ventas@nuvitt.com.
# Tras el primer envío FormSubmit manda un correo de activación a esa dirección;
# una vez activado puedes usar el alias aleatorio que te entrega para no exponer el correo.
# NEXT_PUBLIC_FORMSUBMIT_TARGET=ventas@nuvitt.com

# URL del backend PocketBase (solo servidor; nunca con NEXT_PUBLIC_). Lo usa el panel /admin.
POCKETBASE_URL=https://pb-nuvitt.45.45.216.8.sslip.io

# Interruptor de la tienda (precios, carrito, cuentas). Variable de build: "true" para encender.
NEXT_PUBLIC_SHOP_ENABLED=false
